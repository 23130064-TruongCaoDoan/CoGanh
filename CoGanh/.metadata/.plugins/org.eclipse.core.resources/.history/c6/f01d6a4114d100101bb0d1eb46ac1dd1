	public int minimax(boolean maxmin, Board board, int depth) {
		if (depth == 0)
			return heuristic(board);

		if (maxmin) {
			int temp = -999999999;

			for (Board child : getChildren(board)) {
				int value = minimax(false, child, depth - 1);
				if (value > temp) {
					temp = value;
				}
			}
			return temp;
		} else {
			int temp = 999999999;

			for (Board child : getChildren(board)) {
				int value = minimax(false, child, depth - 1);
				if (value < temp) {
					temp = value;
				}
			}
			return temp;
		}
	}

