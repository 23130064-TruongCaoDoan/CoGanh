package model;

public class Board {
	final int Size = 5;
	private Piece[][] board;

	public Board() {
		this.board = creatBoard();
	}

	public Board(Piece[][] board) {
		super();
		this.board = board;
	}


	public Piece[][] getBoard() {
		return board;
	}

	public void setBoard(Piece[][] board) {
		this.board = board;
	}

	private Piece[][] creatBoard() {
		Piece[][] b = new Piece[Size][Size];

		// Ví dụ khởi tạo đơn giản
		for (int i = 0; i < Size; i++) {
			for (int j = 0; j < Size; j++) {
				if (i == 0)
					b[i][j] = new Piece("black", i, j);
				else if (i == 4)
					b[i][j] = new Piece("white", i, j);
				else if (i == 1 && (j == 0 || j == 4))
					b[i][j] = new Piece("black", i, j);
				else if (i == 2 && (j == 0))
					b[i][j] = new Piece("black", i, j);
				else if (i == 2 && (j == 4))
					b[i][j] = new Piece("white", i, j);
				else if (i == 3 && (j == 0 || j == 4))
					b[i][j] = new Piece("white", i, j);
				else
					b[i][j] = new Piece("emty", i, j);
			}
		}

		return b;
	}

	public Piece getPiece(int r, int c) {
		// TODO Auto-generated method stub
		return board[r][c];
	}

	public void move(int fX, int fY, int toX, int toY) {
		board[toX][toY] = board[fX][fY];
		board[fX][fY] = new Piece("emty", fX, fY);
	}

	public boolean inBoard(int r, int c) {
		return r >= 0 && r < Size && c >= 0 && c < Size;
	}

	public boolean isDiagonalAllowed(int r, int c) {
		final int[][] choPhepCheo = { { 0, 0 }, { 0, 2 }, { 0, 4 }, { 1, 1 }, { 1, 3 }, { 2, 0 }, { 2, 2 }, { 2, 4 },
				{ 3, 1 }, { 3, 3 }, { 4, 0 }, { 4, 2 }, { 4, 4 } };

		for (int[] pos : choPhepCheo) {
			if (pos[0] == r && pos[1] == c) {
				return true;
			}
		}
		return false;
	}

	public boolean isMoveValid(int fX, int fY, int toX, int toY, String currentColor) {
		if (board[fX][fY].getColor().equals("emty") || !board[fX][fY].getColor().equals(currentColor)) {
			return false;
		}

		if (!inBoard(fX, fY) || !inBoard(toX, toY)) {
			return false;
		}

		if (!board[toX][toY].getColor().equals("emty")) {
			return false;
		}
		int dr = Math.abs(toX - fX);
		int dc = Math.abs(toY - fY);

		if (dr > 1 || dc > 1 || (dr == 0 && dc == 0)) {
			return false;
		}

		boolean isDiagonalMove = (dr == 1 && dc == 1);

		if (isDiagonalMove) {
			if (!isDiagonalAllowed(fX, fY)) {
				return false;
			}
		}

		return true;
	}

	public void reset() {
		this.board = creatBoard();

	}

	public boolean isColorMatch(int r, int c, String enemyColor) {
		return !board[r][c].getColor().equals("emty") && board[r][c].getColor().equals(enemyColor);
	}

	public int countPiece(boolean b) {
		int total = 0;
		for (int i = 0; i < Size; i++) {
			for (int j = 0; j < Size; j++) {
				if (b) {
					if (getPiece(i, j).getColor().equals("white"))
						total++;
				} else {
					if (getPiece(i, j).getColor().equals("black"))
						total++;
				}
			}
		}
		return total;
	}

	public int countPieceCenter(boolean b) {
		int total = 0;
		for (int i = 1; i < 4; i++) {
			for (int j = 1; j < 4; j++) {
				if (b) {
					if (getPiece(i, j).getColor().equals("white"))
						total++;
				} else {
					if (getPiece(i, j).getColor().equals("black"))
						total++;
				}
			}
		}
		return total;
	}

}
